EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_ENV=development

# The venue this handset scans for, sent as X-Organization-Id on every call.
#
# OPTIONAL — leave it blank for normal use. On first sign-in the app now calls
# GET /api/v2/organizations and binds the venue automatically: one membership
# is taken silently, several prompt the staffer to pick. See
# src/auth/venueBinding.ts.
#
# Set it ONLY to pin a dedicated handset build to one venue (an operator
# shipping a fixed-device build for a single club). It takes precedence over
# both discovery and the on-device binding.
#
# It is checked against the signed-in account's memberships on every login.
# If the account is not a member, sign-in stops with an explicit error rather
# than silently falling back to a different venue — a wrong pin here is a
# deployment mistake, and quietly pointing a door scanner somewhere else would
# hide it. (Leave the on-device binding out of this: that one IS replaced
# silently, because it goes stale whenever a different account signs in.)
EXPO_PUBLIC_ORGANIZATION_ID=
