{
  "extends": "@c1rcle/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "*.config.ts",
    "e2e/**/*.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
