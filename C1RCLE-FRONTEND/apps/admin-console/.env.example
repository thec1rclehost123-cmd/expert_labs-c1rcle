# C1RCLE Admin Console
#
# Copy to .env.local and fill in. Every variable here is declared in
# packages/config/src/schema.ts and validated at startup — a missing or
# malformed value fails the build rather than producing a broken page.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. Never put a secret
# in one. This repository holds no secrets at all.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME="C1RCLE Admin Console"
NEXT_PUBLIC_APP_ID=admin
NEXT_PUBLIC_ENVIRONMENT=development

# Optional
# NEXT_PUBLIC_SENTRY_DSN=

# Optional, server-only. Shared secret for the gateway's token-gated
# /api/v2/internal/{readiness,version}; the /health page needs it. Set it in
# .env.local or the deploy environment — never commit a real value.
# GATEWAY_READINESS_TOKEN=
