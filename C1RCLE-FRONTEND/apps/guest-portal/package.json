    "@c1rcle/contracts": "workspace:*",
    "@c1rcle/design-system": "workspace:*",
    "@c1rcle/hooks": "workspace:*",
    "@c1rcle/icons": "workspace:*",
    "@c1rcle/providers": "workspace:*",
    "@c1rcle/types": "workspace:*",
    "@c1rcle/ui": "workspace:*",
    "@c1rcle/utils": "workspace:*",
    "@hookform/resolvers": "5.7.1",
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "server-only": "0.0.1",
