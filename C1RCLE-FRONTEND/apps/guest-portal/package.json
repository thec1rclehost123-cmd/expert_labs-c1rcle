{
  "name": "@c1rcle/app-guest-portal",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --cache --cache-location .next/cache/eslint",
    "typecheck": "tsc -p tsconfig.build.json",
    "typecheck:all": "tsc -p tsconfig.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next .turbo coverage playwright-report test-results *.tsbuildinfo"
  },
  "dependencies": {
    "@c1rcle/api-client": "workspace:*",
