{
  "extends": "@c1rcle/tsconfig/react-library.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "*.config.ts",
    "vitest.setup.ts",
    "eslint.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
